{
  "name": "upthere",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time 3D satellite and debris tracker",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "ootk": "^7.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "space.upthere.app",
    "productName": "UpThere",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": false,
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "UpThere-${version}-portable.exe"
    }
  }
}
