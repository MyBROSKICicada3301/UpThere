# KeepTrack API key. Get a free key at https://api.keeptrack.space
#
# Optional. If set, the key is baked into the bundle at build time (fine for
# local development, NOT for publicly hosted builds). If left unset, the app
# asks for a key on first launch and stores it in localStorage on the device.
#
# Copy this file to .env.local and fill in your key:
#   cp .env.example .env.local
VITE_KT_API_KEY=
